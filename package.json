    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.40.0",
    "eslint-config-universe": "^11.2.0",
    "jest": "^29.6.4",
    "jest-expo": "~51.0.1",
    "lint-staged": "^13.3.0",
    "metro-config": "~0.80.4",
    "prettier": "^2.8.8",
    "react-native-testing-library": "^6.0.0",
    "react-test-renderer": "^18.2.0",
    "typescript": "~5.3.3"
