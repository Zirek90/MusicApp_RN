{
  "name": "music-player",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild --platform android && node postinstall.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "eslint ./src ./app",
    "lint:fix": "eslint --fix ./src ./app",
    "format": "prettier --check ./src ./app",
    "format:fix": "prettier --write ./src ./app",
    "pre-commit": "lint-staged",
    "execute-husky": "npx husky install && npx husky add .husky/pre-commit",
    "build:android": "eas build --platform android"
  },
  "dependencies": {
    "@expo/metro-config": "~0.19.0",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^7.0.14",
    "@supersami/rn-foreground-service": "^2.1.1",
    "expo": "^52.0.38",
    "expo-application": "~6.0.2",
    "expo-av": "~15.0.2",
    "expo-build-properties": "~0.13.2",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.13",
    "expo-font": "~13.0.4",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-media-library": "~17.0.6",
    "expo-router": "~4.0.18",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.8",
    "expo-updates": "~0.27.3",
    "expo-web-browser": "~14.0.2",
    "native-base": "^3.4.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-gradle-plugin": "^0.71.19",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.3"
