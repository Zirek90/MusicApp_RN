{
  "name": "music-player",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild --platform android && node postinstall.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "eslint ./src ./app",
    "lint:fix": "eslint --fix ./src ./app",
    "format": "prettier --check ./src ./app",
    "format:fix": "prettier --write ./src ./app",
    "pre-commit": "lint-staged",
    "execute-husky": "npx husky install && npx husky add .husky/pre-commit",
    "build:android": "eas build --platform android"
  },
  "dependencies": {
    "@expo/metro-config": "~0.18.1",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.0.2",
    "@reduxjs/toolkit": "^1.9.5",
    "@supersami/rn-foreground-service": "^2.1.1",
    "expo": "^51.0.0",
    "expo-av": "~14.0.4",
    "expo-build-properties": "~0.12.1",
    "expo-constants": "~16.0.1",
    "expo-dev-client": "~4.0.13",
    "expo-font": "~12.0.5",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-media-library": "~16.0.3",
    "expo-router": "~3.5.12",
    "expo-splash-screen": "~0.27.4",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.4",
    "expo-web-browser": "~13.0.3",
    "native-base": "^3.4.28",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-gradle-plugin": "^0.71.19",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.6",
    "react-redux": "^8.0.5",
    "expo-updates": "~0.25.11",
    "expo-application": "~5.9.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.2.2",
